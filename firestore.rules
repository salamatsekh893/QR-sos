rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Catch-all default deny for safety
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection - Allow public read and write for user profiles (demo and auth users)
    match /users/{userId} {
      allow read, write: if true;
    }

    // Emergency Contacts
    match /emergency_contacts/{contactId} {
      allow read, write: if true;
    }

    // Medical Profiles
    match /medical_profiles/{userId} {
      allow read, write: if true;
    }

    // QR Identity Tags (Scannable publicly by emergency responders)
    match /qr_codes/{qrId} {
      allow read, write: if true; 
    }

    // SOS Alerts (Live emergency tracking)
    match /sos_alerts/{alertId} {
      allow read, write: if true;
    }

    // Product Orders
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Wallet Transactions
    match /wallet_transactions/{transId} {
      allow read, write: if true;
    }
  }
}
